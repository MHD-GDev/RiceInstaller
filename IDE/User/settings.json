{
    "diffEditor.experimental.showEmptyDecorations": false,
    "diffEditor.experimental.useTrueInlineView": true,
    "diffEditor.wordWrap": "inherit",
    "editor.acceptSuggestionOnCommitCharacter": true,
    "editor.autoIndent": "full",
    "editor.autoIndentOnPaste": true,
    "editor.codeLens": true,
    "editor.codeLensFontFamily": "",
    "editor.codeLensFontSize": 16,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.dragAndDrop": false,
    "editor.dropIntoEditor.enabled": false,
    "editor.experimentalWhitespaceRendering": "off",
    "editor.fastScrollSensitivity": 10,
    "editor.find.history": "never",
    "editor.find.replaceHistory": "never",
    "editor.folding": false,
    "editor.fontFamily": "'Meslo LG M', 'monospace', monospace",
    "editor.fontSize": 16,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": false,
    "editor.lightbulb.enabled": "off",
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.multiCursorModifier": "alt",
    "editor.padding.bottom": 5,
    "editor.padding.top": 5,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollBeyondLastLine": false,
    "editor.selectionClipboard": true,
    "editor.showFoldingControls": "never",
    "editor.smoothScrolling": true,
    "editor.suggest.preview": true,
    "editor.tabCompletion": "off",
    "editor.tabSize": 4,
    "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
    "editor.wordWrap": "on",
    "security.workspace.trust.banner": "never",
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.untrustedFiles": "open",
    "accessibility.dimUnfocused.enabled": true,
    "accessibility.dimUnfocused.opacity": 0.45,
    "workbench.activityBar.location": "top",
    "workbench.colorTheme": "Default High Contrast",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "workbench.editor.wrapTabs": true,
    "workbench.enableExperiments": false,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.layoutControl.type": "toggles",
    "workbench.list.smoothScrolling": true,
    "workbench.navigationControl.enabled": false,
    "workbench.panel.defaultLocation": "bottom",
    "workbench.reduceMotion": "on",
    "workbench.settings.editor": "json",
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.sideBar.location": "left",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.startupEditor": "none",
    "workbench.statusBar.visible": false,
    "workbench.tips.enabled": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "window.customMenuBarAltFocus": false,
    "window.enableMenuBarMnemonics": false,
    "window.menuBarVisibility": "hidden",
    "window.openFoldersInNewWindow": "on",
    "files.readonlyFromPermissions": true,
    "update.mode": "none",
    "markdown.preview.fontFamily": "Meslo LG M",
    "markdown.preview.fontSize": 16,
    "chat.tools.terminal.enableAutoApprove": false,
    "terminal.integrated.localEchoExcludePrograms": [
        "vim",
        "vi",
        "nano",
        "tmux",
        "nvim",
        "emacs"
    ],
    "terminal.integrated.env.linux": {
        "PS1": "\\w\\$ "
    },
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "git.enabled": false,
    "markdown.extension.completion.enabled": true,
    "chat.commandCenter.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
}
