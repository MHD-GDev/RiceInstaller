/* Default palette for the menu themes.
 *
 * Every menu theme in this directory does `@import "shared-colors.rasi"`, so
 * this file has to exist before any rofi menu can resolve a colour.
 *
 * rice-selector replaces it with a symlink to
 * ../rices/<active rice>/rofi/shared-colors.rasi as soon as a rice is
 * applied. That is exactly why the checked-in copy is a real file rather than
 * a symlink: a symlink committed here could only ever resolve on the machine
 * that created it.
 *
 * The values below are the Rainbow palette, matching the rice named in
 * ../.current_rice, so the first boot looks the same as the first rice
 * switch.
 */
* {
    bg-col:         #54487A;
    bg-col-light:   #333C44;
    border-col:     #2B3339;
    selected-col:   #333C44;
    blue:           #fba922;
    fg-col:         #D3C6AA;
    fg-col2:        #fba922;
    grey:           #859289;
    width:          600;
    font:           "MesloLGL Nerd Font Mono 14";
}