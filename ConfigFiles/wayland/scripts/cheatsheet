#!/usr/bin/env bash

# ┌─ CHEATSHEET SELECTOR ─┐
#
# AUTHOR: MHD

set -uo pipefail

_lib=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/common.sh
. "$_lib/lib/common.sh"

SCRIPTS_DIR="$_lib/cheatsheets"
THEME_PATH="$WAYLAND_THEMES_DIR/cheatsheet.rasi"

# Check if scripts directory exists
if [[ ! -d $SCRIPTS_DIR ]]; then
    rofi_error "Scripts directory not found: $SCRIPTS_DIR"
    exit 1
fi

# Check if theme file exists
if [[ ! -f $THEME_PATH ]]; then
    rofi_error "Theme file not found: $THEME_PATH"
    exit 1
fi

# Find all cheatsheet files
cheatsheets=$(find "$SCRIPTS_DIR" -name "*cheatsheet*" -type f -printf "%f\n" | sort)

# Create list
cheatsheet_list=()
while IFS= read -r cs; do
    [[ -n $cs ]] || continue
    # "nvim_cheatsheet" -> "nvim", a bare "cheatsheet" -> "hypr"
    appname=${cs%_cheatsheet}
    [[ $appname == "cheatsheet" ]] && appname="hypr"
    cheatsheet_list+=("$appname")
done <<<"$cheatsheets"

# Check if any cheatsheets were found
if ((${#cheatsheet_list[@]} == 0)); then
    rofi_error "No cheatsheets found in $SCRIPTS_DIR"
    exit 1
fi

# Show rofi menu and get user selection
selected=$(printf '%s\n' "${cheatsheet_list[@]}" | rofi -dmenu -theme "$THEME_PATH" -p "Cheatsheet")

# Process selection
if [[ -n $selected ]]; then
    appname="$selected"
    cs_path="$SCRIPTS_DIR/${appname}_cheatsheet"

    if [[ -x $cs_path ]]; then
        # Execute the cheatsheet
        "$cs_path" &
    elif [[ -f $cs_path ]]; then
        # If not executable, try to run with python3
        python3 "$cs_path" &
    else
        rofi_error "Cheatsheet not found: $cs_path"
    fi
fi
