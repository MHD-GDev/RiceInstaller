    def on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        if not query:
            for row in self.all_rows:
                row.set_visible(True)
            return
        for row in self.all_rows:
            desc = row.get_first_child().get_label().lower()
            keys = row.get_last_child().get_label().lower()
            if difflib.get_close_matches(query, [desc, keys], n=1, cutoff=0.4):
                row.set_visible(True)
            else:
                row.set_visible(False)


class CheatsheetApp(Gtk.Application):
    def __init__(self):
        super().__init__(flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.window = None

    def do_activate(self, *args, **kwargs):
        if not self.window:
            self.window = CheatsheetWindow(self)
        self.window.present()


def main():
    app = CheatsheetApp()
    app.run(sys.argv)


if __name__ == "__main__":
    main()
