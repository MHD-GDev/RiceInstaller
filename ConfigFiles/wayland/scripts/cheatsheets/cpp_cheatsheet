class CheatsheetWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title(APP_NAME)
        self.set_default_size(1000, 700)
        self.set_decorated(False)
        self.set_focusable(True)
        key_controller = Gtk.EventControllerKey()
        key_controller.connect("key-pressed", self.on_key_pressed)
        self.add_controller(key_controller)

        provider = Gtk.CssProvider()
        provider.load_from_data(self._css().encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.add_css_class("cheatsheet")
        self.set_child(outer)

        # App Icon
        icon = Gtk.Label(label="\ue61d")
        icon.set_halign(0.5)
        icon.add_css_class("icon")
        outer.append(icon)

        # Search entry
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Fuzzy search...")
        self.search_entry.set_visible(False)
        self.search_entry.add_css_class("search-entry")
        self.search_entry.connect("search-changed", self.on_search_changed)
        outer.append(self.search_entry)

        # Scrollable content
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.set_hexpand(True)
        scroll.set_vexpand(True)
        outer.append(scroll)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.add_css_class("content")
        content.set_hexpand(True)
        content.set_vexpand(True)
        scroll.set_child(content)

        self.all_rows = []

        # Sections
        for section, items in CHEATSHEET:
            cat = Gtk.Label(label=section.upper())
            cat.add_css_class("category")
            cat.set_xalign(0.0)
            content.append(cat)

            for keys, desc in items:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                row.set_hexpand(True)
                row.add_css_class("keys-row")

                left = Gtk.Label(label=desc)
                left.add_css_class("keys")
                left.set_xalign(0.0)
                left.set_hexpand(True)

                right = Gtk.Label(label=keys)
                right.add_css_class("keys-alt")
                right.set_xalign(1.0)
                right.set_hexpand(False)

                row.append(left)
                row.append(right)
                content.append(row)
                self.all_rows.append(row)

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_q:
            self.destroy()
        elif keyval == Gdk.KEY_slash:
            self.search_entry.set_visible(True)
            self.search_entry.grab_focus()
        elif keyval == Gdk.KEY_Escape:
            self.search_entry.set_visible(False)
            self.search_entry.set_text("")
            for row in self.all_rows:
                row.set_visible(True)

    def _css(self):
        c = COLORS
        return f"""
.cheatsheet {{
  background-color: {c['bg']};
  border-radius: 8px;
}}
.icon {{
  font-family: "Meslo LG M", monospace;
  font-size: 8rem;
  color: {c['blue']};
  margin: 1rem;
  text-shadow: 0 0 6px {c['blue']};
}}
