#!/bin/bash

# ┌─ System Updater ─┐
#
#   AUTHOR: MHD

# Permanent excludes: Add package names here to always exclude them from updates
PERMANENT_EXCLUDES=(
    # "pkg1"
    # "pkg2"
)

# Detect distribution
if [ -f /etc/gentoo-release ]; then
    DISTRO="gentoo"
elif [ -f /etc/arch-release ]; then
    DISTRO="arch"
else
    echo "Unsupported distribution. This script supports Gentoo and Arch Linux."
    exit 1
fi

# Parse command line options
EXCLUDE=""
while [[ $# -gt 0 ]]; do
    case $1 in
    --exclude)
        if [ -z "$2" ] || [[ "$2" == --* ]]; then
            echo "Error: --exclude requires a package name argument."
            exit 1
        fi
        EXCLUDE="$2"
        shift 2
        ;;
    -h | --help)
        echo "Usage: $0 [--exclude PACKAGE]"
        echo "Update system packages for Gentoo or Arch Linux."
        echo "  --exclude PACKAGE  Skip updating the specified package"
        exit 0
        ;;
    *)
        echo "Unknown option: $1"
        echo "Use -h or --help for usage information."
        exit 1
        ;;
    esac
done

# Combine permanent and command-line excludes
ALL_EXCLUDES=("${PERMANENT_EXCLUDES[@]}")
if [ -n "$EXCLUDE" ]; then
    ALL_EXCLUDES+=("$EXCLUDE")
fi

# Perform update based on distribution
if [ "$DISTRO" = "gentoo" ]; then
    echo "Detected Gentoo Linux. Updating system..."
    if [ ${#ALL_EXCLUDES[@]} -gt 0 ]; then
        EXCLUDE_ARGS=""
        for pkg in "${ALL_EXCLUDES[@]}"; do
            EXCLUDE_ARGS="$EXCLUDE_ARGS --exclude=$pkg"
        done
        sudo emerge --sync && sudo emerge -uDN @world "$EXCLUDE_ARGS"
    else
        sudo emerge --sync && sudo emerge -uDN @world
    fi
elif [ "$DISTRO" = "arch" ]; then
    echo "Detected Arch Linux. Updating system..."
    if [ ${#ALL_EXCLUDES[@]} -gt 0 ]; then
        IGNORE_LIST=""
        for pkg in "${ALL_EXCLUDES[@]}"; do
            if [ -n "$IGNORE_LIST" ]; then
                IGNORE_LIST="$IGNORE_LIST,$pkg"
            else
                IGNORE_LIST="$pkg"
            fi
        done
        sudo pacman -Syu --ignore="$IGNORE_LIST"
    else
        sudo pacman -Syu
    fi
fi
