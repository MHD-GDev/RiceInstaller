#!/bin/bash

# ─ mpv tui ─
#
# A minimal terminal frontend for mpv.
#
# Design: one frame, three regions — a header bar, a list, a footer hint.
# Structural changes repaint the whole frame once; navigation repaints only
# the rows that changed; playback status updates a single fixed row without
# ever clearing the screen or redrawing the cover art.

# AUTHOR: MHD

readonly _esc=$'\e'

# ── Palette ───────────────────────────────────────────────────────────────
# colour is reserved for meaning: accent = selection, green/amber = state,
# red = errors. Everything else stays neutral so the screen reads quiet.
DIM='' BOLD='' ACCENT='' GOOD='' WARN='' ERR='' RESET=''
init_style() {
    BOLD=$(tput bold)
    DIM=$(tput dim)
    ACCENT=$(tput setaf 5)
    GOOD=$(tput setaf 2)
    WARN=$(tput setaf 3)
    ERR=$(tput setaf 1)
    RESET=$(tput sgr0)
}

# ── Terminal addressing ──────────────────────────────────────────────────
# Build absolute cursor sequences with printf instead of tput per row. A
# terminal whose cup is unusual falls back to tput; output is identical.
CUP_LEAD='' CUP_FAST=0 EL=''
if _cup0=$(tput cup 0 0 2>/dev/null) && [[ $_cup0 == "${_esc}["*'H'* ]]; then
    CUP_LEAD="${_esc}["
    CUP_FAST=1
fi
EL=$(tput el 2>/dev/null)

# Move to a 0-based row, column 1.
row_at() {
    if ((CUP_FAST)); then
        printf '%s%d;1H' "$CUP_LEAD" "$((1 + $1))"
    else
        tput cup "$1" 0
    fi
}

# Bash refreshes COLUMNS/LINES on window changes once checkwinsize is on —
# no `tput cols` fork per repaint.
shopt -s checkwinsize
refresh_size() {
    W=${COLUMNS:-80}
    H=${LINES:-24}
}

centre_var() {
    local __name="$1" text="$2" width="${3:-$W}"
    # Measure visible width only: tput mixes SGR \e[...m and charset \e(B
    # escapes, which must not count as columns. Glob-strip equivalents
    # backtracked greedily and swallowed text (the "m" in "mp3"), so this is
    # a plain scan instead.
    local i len=${#text} ch visible='' state=0
    for ((i = 0; i < len; i++)); do
        ch=${text:i:1}
        case $state in
        0) if [[ $ch == "$_esc" ]]; then state=1; else visible+=$ch; fi ;;
        1) case $ch in
           '[') state=2 ;;
           '(') state=3 ;;
           *) state=0 ;;
           esac ;;
        2) [[ $ch == 'm' ]] && state=0 ;;
        3) [[ $ch == 'B' ]] && state=0 ;;
        esac
    done
    local text_len=${#visible}
    ((width < text_len)) && width=$text_len
    local pad=$(((width - text_len) / 2))
    printf -v "$__name" '%*s%s%*s' "$pad" '' "$text" "$((width - text_len - pad))" ''
}

# Centred line that also wipes whatever was on that row before it.
centre_print() {
    local line
    centre_var line "$1" "$W"
    printf '%s%s' "$EL" "$line"
}

# ── State ────────────────────────────────────────────────────────────────
W=80 H=24
declare -a MEDIA_FILES=() LAST_ROWS=()
index=0 offset=0 window=10
LIST_TOP=1
CURRENT_TITLE='' MEDIA_COVER_PATH='' VIEWER=''
PAUSED=0 LOOPING=0 MPV_PID=''
FFMPEG_BIN='' FFPROBE_BIN=''

now_ms() { LAST_REDRAW_TIME=${EPOCHREALTIME/./} ; }
should_redraw() {
    (( ${EPOCHREALTIME/./} - LAST_REDRAW_TIME >= REDRAW_INTERVAL_MS * 1000 ))
}
REDRAW_INTERVAL_MS="${REDRAW_INTERVAL_MS:-16}"
LAST_REDRAW_TIME=0

# ── Frame: header / list / footer ────────────────────────────────────────
paint_header() {
    local total=${#MEDIA_FILES[@]}
    local right="${total} tracks"
    local gap=$((W - 7 - ${#right}))
    ((gap < 1)) && gap=1
    printf '%s%*s%s%s' \
        "${BOLD}mpv${RESET} ${DIM}tui${RESET}" \
        "$gap" "" \
        "${DIM}${right}${RESET}" \
        "$EL"
}

paint_footer() {
    row_at $((H - 1))
    centre_print "${DIM}j/k move · enter play · / find · c cleanup covers · L loop · q quit${RESET}"
}

# Repaint the visible window, readdressing only rows whose content changed.
paint_list() {
    local total=${#MEDIA_FILES[@]}
    local end=$((offset + window - 1))
    ((end >= total)) && end=$((total - 1))

    local new=() line i
    for ((i = offset; i <= end && i < total; i++)); do
        local base=${MEDIA_FILES[i]##*/}
        if ((i == index)); then
            centre_var line "${ACCENT}▸${RESET} ${BOLD}${base}${RESET}"
        else
            centre_var line "$base"
        fi
        new+=("$line")
    done
    for ((i = ${#new[@]}; i < window; i++)); do
        centre_var line ''
        new+=("$line")
    done

    for ((i = 0; i < window; i++)); do
        [[ ${LAST_ROWS[i]-} == "${new[i]}" ]] && continue
        row_at $((LIST_TOP + i))
        printf '%s' "${new[i]}"
    done
    LAST_ROWS=("${new[@]}")
}

# Full repaint — used on entry, after playback/cleanup, and on resize.
paint_browse() {
    refresh_size
    window=$((H - 3))
    ((window < 1)) && window=1
    clear
    row_at 0
    paint_header
    LAST_ROWS=()
    paint_list
    paint_footer
}

# ── Search ───────────────────────────────────────────────────────────────
# The footer row doubles as the prompt; query stays local to the screen.
run_search() {
    row_at $((H - 1))
    printf '%s' "${ACCENT}/${RESET} ${DIM}(enter to jump, empty to cancel)${RESET}"
    tput cnorm
    local query=''
    IFS= read -r query
    tput civis
    paint_footer
    [[ -z $query ]] && return

    local q=${query,,} i base
    for ((i = 0; i < ${#MEDIA_FILES[@]}; i++)); do
        base=${MEDIA_FILES[i]##*/}
        if [[ ${base,,} == *"$q"* ]]; then
            index=$i
            offset=$(((i < window / 2) ? 0 : i - window / 2))
            ((offset < 0)) && offset=0
            paint_list
            return
        fi
    done
    row_at $((H - 1))
    centre_print "${ERR}no match: ${query}${RESET}"
    sleep 1
    paint_footer
}

# ── Cover art ──────────────────────────────────────────────────────────
# Sources, ordered by how well they match the *actual* cover (all keyless
# public services — no signups, no tokens, stays seamless):
#   1. cache in $COVER_DIR from an earlier run
#   2. artwork embedded in the music file itself — the true cover
#   3. iTunes Search API: album-term lookup, verified against the file's
#      artist tag so a name collision can't hand back unrelated art
#   4. Deezer API: *track* search — a single song resolves to the song's
#      real album art instead of merch/AI covers trading its name
#   5. MusicBrainz + Cover Art Archive: community-verified art
# A .nocover sidecar records "nothing found online", but embedded art
# outranks it — there is no lookup to fail, so a stale marker can never
# hide a cover the file actually carries.

COVER_DIR="${COVER_DIR:-$HOME/Pictures/CoverArts}"
MB_UA="mpv-tui cover fetcher (local script)"

# Lift the artwork stream out of the file itself (ffmpeg re-encodes any
# picture codec into MJPEG). Files without art simply fail here.
extract_embedded_cover() {
    local file="$1" base="$2" tmp
    [[ -n $FFMPEG_BIN ]] || return 1
    tmp="$COVER_DIR/.tmp-$base.jpg"
    "$FFMPEG_BIN" -hide_banner -loglevel error -y \
        -i "$file" -map 0:v:0 -frames:v 1 \
        -vcodec mjpeg -qscale:v 2 "$tmp" 2>/dev/null || {
        rm -f -- "$tmp"
        return 1
    }
    # Tiny files are conversions gone wrong, not art.
    if [[ $(stat -c%s "$tmp" 2>/dev/null || echo 0) -lt 1000 ]]; then
        rm -f -- "$tmp"
        return 1
    fi
    mv -f -- "$tmp" "$COVER_DIR/$base.jpg"
    MEDIA_COVER_PATH="$COVER_DIR/$base.jpg"
    return 0
}

# Fill TAG_ARTIST / TAG_ALBUM / TAG_TITLE from the file's metadata.
read_media_tags() {
    local file="$1" line
    TAG_ARTIST='' TAG_ALBUM='' TAG_TITLE=''
    [[ -n $FFPROBE_BIN ]] || return 1
    while IFS= read -r line; do
        case $line in
        album_artist=*) TAG_ALBUM_ARTIST=${line#*=} ;;
        artist=*) TAG_ARTIST=${line#*=} ;;
        album=*) TAG_ALBUM=${line#*=} ;;
        title=*) TAG_TITLE=${line#*=} ;;
        esac
    done < <("$FFPROBE_BIN" -v error \
        -show_entries format_tags=album_artist,artist,album,title \
        -of default=noprint_wrappers=1 "$file" 2>/dev/null)
    return 0
}

# Filename → usable search text. YouTube-style rips carry marketing junk
# that drags back unrelated/AI covers, or nothing at all.
clean_query() {
    local s=$1 ch i out='' depth=0
    s=${s##*/}
    s=${s%.*}
    # Drop every bracketed section (YouTube-style junk lives there). A
    # simple depth counter avoids bracket-class regexes, whose `]`-classes
    # are not portable between bash, sed and grep.
    local len=${#s}
    for ((i = 0; i < len; i++)); do
        ch=${s:i:1}
        case $ch in
        '(' | '[' | '{') ((depth++)) ;;
        ')' | ']' | '}') ((depth > 0)) && ((depth--)) ;;
        *) ((depth == 0)) && out+=$ch ;;
        esac
    done
    s=$out
    s=$(sed -E '
        s/\b(official|video|audio|lyrics?|visuali[sz]er|preview|teaser|snippet|hd|hq|4k|full|free|download|version|remix(ed)?|extended|stereo|mono|prod(uced)?|featuring|feat|cover|art)\b/ /Ig;
        s/[^[:alnum:]& ]+/ /g;
        s/ +/ /g;
        s/^ +//; s/ +$//
    ' <<<"$s")
    printf '%s' "$s"
}

# Loose artist comparison: alphanumerics only, substring either way. An
# empty wanted tag means "no opinion" — accept the candidate.
artist_matches() {
    local want=${1,,} have=${2,,}
    want=${want//[^a-z0-9]/}
    have=${have//[^a-z0-9]/}
    [[ -z $want ]] && return 0
    [[ -n $have && ( $have == *$want* || $want == *$have* ) ]]
}

# Iterate an iTunes/Deezer result list until a candidate matches the
# artist tag (or the tag is absent). Prints an artwork URL on success.
# Result rows for both APIs are `<artist>\t<image url>`, so one loop fits
# both: iTunes artworkUrl100 (upgraded to 600x600) and Deezer cover_xl.
rows_to_art() {
    local artist="$1" have url
    while IFS=$'\t' read -r have url; do
        [[ -z $url ]] && continue
        if artist_matches "$artist" "$have"; then
            printf '%s' "${url/100x100bb/600x600bb}"
            return 0
        fi
    done
    return 1
}

itunes_art() {
    # $1 entity (song|album), $2 term, $3 artist tag, $4 optional attribute
    local entity="$1" term="$2" artist="$3"
    local -a args=(--data-urlencode "term=$term" -d entity="$entity" -d limit=5)
    [[ -n $4 ]] && args+=(-d attribute="$4")
    local body
    body=$(curl -fsSG --max-time 8 'https://itunes.apple.com/search' \
        "${args[@]}" 2>/dev/null) || return 1
    jq -r '.results[] | select((.artworkUrl100 // "") != "") | [(.artistName // ""), .artworkUrl100] | @tsv' \
        <<<"$body" 2>/dev/null | rows_to_art "$artist"
}

deezer_art() {
    # $1 kind (song→track | album), $2 term, $3 artist tag
    local kind="$1" term="$2" artist="$3"
    if [[ $kind == song ]]; then
        kind=track
    fi
    local body rows
    body=$(curl -fsSG --max-time 8 "https://api.deezer.com/search/$kind" \
        --data-urlencode "q=$term" 2>/dev/null) || return 1
    if [[ $kind == track ]]; then
        rows=$(jq -r '[.data[] | select((.album.cover_xl // "") != "") | [(.artist.name // ""), .album.cover_xl]][] | @tsv' \
            <<<"$body" 2>/dev/null)
    else
        rows=$(jq -r '[.data[] | select((.cover_xl // "") != "") | [(.artist.name // ""), .cover_xl]][] | @tsv' \
            <<<"$body" 2>/dev/null)
    fi
    printf '%s\n' "$rows" | rows_to_art "$artist"
}

# MusicBrainz locates the exact release, the Cover Art Archive serves its
# front image. Both keyless; MB only asks for ≤1 query/second.
caa_art() {
    local artist="$1" album="$2" mbid
    mbid=$(curl -fsSG --max-time 8 -A "$MB_UA" \
        'https://musicbrainz.org/ws/2/release' \
        --data-urlencode "query=artist:\"$artist\" AND release:\"$album\"" \
        -d fmt=json -d limit=1 2>/dev/null | \
        jq -r '.releases[0].id // empty' 2>/dev/null) || return 1
    [[ -n $mbid ]] || return 1
    sleep 1
    printf 'https://coverartarchive.org/release/%s/front-500' "$mbid"
}

download_cover() {
    local file="$1" music_name base_name cover_path nocover_path url

    music_name=${file##*/}
    base_name="${music_name%.*}"
    cover_path="$COVER_DIR/$base_name.jpg"
    nocover_path="$COVER_DIR/$base_name.nocover"

    mkdir -p "$COVER_DIR" || return 1

    # 1. Cached art from an earlier run.
    if [[ -f $cover_path ]]; then
        MEDIA_COVER_PATH="$cover_path"
        return 0
    elif [[ -f $COVER_DIR/$base_name.png ]]; then
        MEDIA_COVER_PATH="$COVER_DIR/$base_name.png"
        return 0
    fi

    # 2. Embedded artwork — the real thing, no lookup. This also rescues
    # files previously marked .nocover.
    if extract_embedded_cover "$file" "$base_name"; then
        return 0
    fi

    # 3+. Online lookup (skipped when a previous run found nothing).
    if [[ -f $nocover_path ]]; then
        return 1
    fi

    read_media_tags "$file"
    local artist=${TAG_ARTIST:-$TAG_ALBUM_ARTIST}
    local album=$TAG_ALBUM
    local fallback
    fallback=$(clean_query "$music_name")

    local url=''
    if [[ -n $album ]]; then
        # Real album lookups: verified against the artist tag.
        url=$(itunes_art album "$album" "$artist" albumTerm)
        if [[ -z $url ]]; then
            url=$(deezer_art album "$album" "$artist")
        fi
        if [[ -z $url && -n $artist ]]; then
            url=$(caa_art "$artist" "$album")
        fi
    fi

    # Single songs rarely cross an album search: hit the track databases,
    # whose result covers are the song's actual album art.
    local song_query="${artist:+$artist }${title:+$title}"
    [[ -z $song_query ]] && song_query=$fallback
    if [[ -z $url ]]; then
        url=$(itunes_art song "$song_query" "$artist")
    fi
    if [[ -z $url ]]; then
        url=$(deezer_art track "$song_query" "$artist")
    fi

    # Last resort: the cleaned filename.
    if [[ -z $url && $song_query != "$fallback" ]]; then
        url=$(itunes_art song "$fallback" '')
    fi
    if [[ -z $url && $song_query != "$fallback" ]]; then
        url=$(deezer_art track "$fallback" '')
    fi

    if [[ -z $url ]]; then
        : >"$nocover_path"
        return 1
    fi

    if ! curl -fsSL --max-time 15 "$url" -o "$cover_path"; then
        rm -f -- "$cover_path"
        : >"$nocover_path"
        return 1
    fi

    MEDIA_COVER_PATH="$cover_path"
    return 0
}

detect_viewer() {
    if [[ $TERM == xterm-kitty || -n $KITTY_WINDOW_ID ]] && command -v kitty &>/dev/null; then
        VIEWER=kitty
    elif command -v chafa &>/dev/null; then
        VIEWER=chafa
    elif command -v viu &>/dev/null; then
        VIEWER=viu
    elif command -v ascii-image-converter &>/dev/null; then
        VIEWER=ascii-image-converter
    fi
}

# Draw the poster centred inside the play screen's poster region. Output is
# bounded so it can never push the fixed status/controls rows around.
draw_poster() {
    local cover="$1"
    [[ -f $cover ]] || return 1
    if [[ -z $VIEWER ]]; then
        set_status "${WARN}no image viewer (chafa/viu/kitty)"
        sleep 1.2
        return 1
    fi
    local avail=$((H - 7))
    ((avail < 3)) && avail=3

    case $VIEWER in
    kitty)
        # icat sizes the image to the window itself; --align centres it into
        # the remaining columns. Error text would mar the frame, so stderr is
        # suppressed and a failed display is reported through the status row.
        kitty +kitten icat --align center "$cover" 2>/dev/null || {
            set_status "${ERR}cover display failed"
            sleep 1.2
            return 1
        }
        ;;
    chafa)
        chafa -s "${W}x${avail}" "$cover"
        ;;
    *)
        local output n=0 line
        if [[ $VIEWER == viu ]]; then
            output=$(viu -w "$W" "$cover" 2>/dev/null)
        else
            output=$($VIEWER "$cover" 2>/dev/null)
        fi
        while IFS= read -r line; do
            ((n++ >= avail)) && break
            centre_print "$line"
        done <<<"$output"
        ;;
    esac
}

# ── Playback screen ──────────────────────────────────────────────────────
# Layout is fixed: row 0 header, row 2 title, row 3 status, row 4 controls,
# rows 5.. poster. Only the status row ever changes while music plays.
PLAY_STATUS_ROW=3

set_status() {
    row_at "$PLAY_STATUS_ROW"
    centre_print "$1"
}

paint_play_screen() {
    refresh_size
    PLAY_STATUS_ROW=3
    clear
    row_at 0
    paint_header
    row_at 2
    centre_print "${BOLD}${CURRENT_TITLE}${RESET}"
    row_at 4
    centre_print "${DIM}p pause · h −10s · l +10s · L loop · q stop${RESET}"
}

play_file() {
    local file="$1"
    local socket="/tmp/mpv-socket"

    CURRENT_TITLE=${file##*/}
    PAUSED=0
    LOOPING=0
    MEDIA_COVER_PATH=''
    rm -f -- "$socket"

    paint_play_screen
    set_status "${WARN}◌  fetching art…"
    if download_cover "$file" >/dev/null 2>&1 && [[ -f $MEDIA_COVER_PATH ]]; then
        row_at 5
        draw_poster "$MEDIA_COVER_PATH"
    else
        MEDIA_COVER_PATH=''
        set_status "${WARN}no cover art"
    fi

    mpv --quiet --no-terminal --osd-level=0 \
        --no-video --audio-display=no \
        --input-ipc-server="$socket" \
        "$file" &
    MPV_PID=$!

    sleep 0.3
    if ! kill -0 "$MPV_PID" 2>/dev/null; then
        set_status "${ERR}mpv failed to start"
        MPV_PID=''
        sleep 1.2
        return 1
    fi
    set_status "${GOOD}▶  playing"

    # Poll instead of blocking forever on read: `kill -0` succeeds on a
    # zombie child, so mpv finishing the song would go unnoticed until the
    # next keypress. A short read timeout re-checks aliveness regularly; `ps
    # -o stat=` distinguishes a live process from a dead/zombie one.
    local key stat rc
    while :; do
        stat=$(ps -o stat= -p "$MPV_PID" 2>/dev/null)
        [[ -z $stat || $stat == Z* ]] && break
        IFS= read -rsn1 -t 0.25 key
        rc=$?
        ((rc > 128)) && continue # read timed out → loop back to the check
        if ((rc != 0)); then
            break # stdin closed: leave playback
        fi
        while read -rsn1 -t 0.001 extra; do :; done
        case $key in
        p)
            PAUSED=$((1 - PAUSED))
            printf '{"command":["cycle","pause"]}\n' | socat - "$socket" &>/dev/null
            if ((PAUSED)); then
                set_status "${WARN}⏸  paused"
            else
                set_status "${GOOD}▶  playing"
            fi
            ;;
        h)
            printf '{"command":["seek",-10]}\n' | socat - "$socket" &>/dev/null
            set_status "${DIM}◂  −10s"
            ;;
        l)
            printf '{"command":["seek",10]}\n' | socat - "$socket" &>/dev/null
            set_status "${DIM}▸  +10s"
            ;;
        L)
            LOOPING=$((1 - LOOPING))
            if ((LOOPING)); then
                printf '{"command":["set_property","loop-file","inf"]}\n' | socat - "$socket" &>/dev/null
                set_status "${GOOD}⟲  loop on"
            else
                printf '{"command":["set_property","loop-file","no"]}\n' | socat - "$socket" &>/dev/null
                set_status "${WARN}⟲  loop off"
            fi
            ;;
        q)
            printf '{"command":["quit"]}\n' | socat - "$socket" &>/dev/null
            break
            ;;
        esac
    done

    MPV_PID=''
    rm -f -- "$socket"
    wait 2>/dev/null
}

# ── Maintenance ──────────────────────────────────────────────────────────
# Full-screen side task: clear, run, wait for a key, return to the frame.
run_task() {
    tput cnorm
    clear
    local rc=0
    "$@" || rc=$?
    printf '%s\n' ''
    printf '%s' "${DIM}press any key to return${RESET}"
    IFS= read -rsn1
    tput civis
    paint_browse
    return $rc
}

cleanup_orphan_covers() {
    local cover_dir="$HOME/Pictures/CoverArts"

    mkdir -p "$cover_dir"

    local -A valid=()
    local file name
    for file in "${MEDIA_FILES[@]}"; do
        name=${file##*/}
        name=${name%.*}
        valid["$name"]=1
    done

    local img removed=0
    shopt -s nullglob
    for img in "$cover_dir"/*.{jpg,png,svg,jpeg}; do
        name=${img##*/}
        name=${name%.*}
        if ! [[ -v valid[$name] ]]; then
            printf '%s\n' "${WARN}removing orphan cover:${RESET} ${name}"
            rm -f -- "$img"
            removed=$((removed + 1))
        fi
    done
    shopt -u nullglob

    if ((removed == 0)); then
        printf '%s\n' "${GOOD}no orphan covers${RESET}"
    fi
}

# ── Loop keys ────────────────────────────────────────────────────────────

browse_files() {
    local total=${#MEDIA_FILES[@]}
    if ((total == 0)); then
        clear
        centre_print "${ERR}no audio files in the directory${RESET}"
        sleep 2
        return
    fi

    index=0
    offset=0
    tput civis
    paint_browse

    local last_key='' key
    while true; do
        IFS= read -rsn1 key || break
        while read -rsn1 -t 0.001 extra; do :; done
        case $key in
        j)
            ((index < total - 1)) || continue
            ((index++))
            ((index >= offset + window)) && ((offset++))
            if should_redraw; then
                paint_list
                now_ms
            fi
            ;;
        k)
            ((index > 0)) || continue
            ((index--))
            ((index < offset)) && ((offset--))
            if should_redraw; then
                paint_list
                now_ms
            fi
            ;;
        g)
            if [[ $last_key == 'g' ]]; then
                index=0
                offset=0
                paint_list
                last_key=''
                continue
            fi
            ;;
        G)
            index=$((total - 1))
            offset=$((total > window ? total - window : 0))
            paint_list
            ;;
        /)
            run_search
            ;;
        c)
            run_task cleanup_orphan_covers
            ;;
        '')
            play_file "${MEDIA_FILES[index]}"
            paint_browse
            ;;
        q)
            break
            ;;
        esac
        last_key="$key"
    done

    tput cnorm
    clear
}

# ── Main ─────────────────────────────────────────────────────────────────
collect_media_files() {
    local dir="$1"
    mapfile -t MEDIA_FILES < <(find "$dir" -maxdepth 1 -type f \
        \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.wav' -o -iname '*.ogg' -o -iname '*.m4a' \) 2>/dev/null | sort -f)
}

help_text() {
    cat <<'EOF'
mpv tui — minimal terminal frontend for mpv

Usage: mpv-tuiv1 [options]

Options:
  -h, --help        Show this help and exit
  -d, --dir <path>  Music directory (default: ~/Downloads/Telegram Desktop)

Keys in the browser:
  j/k       Move down/up
  gg / G    Jump to top/bottom
  /         Search (enter to jump, empty to cancel)
  Enter     Play selected file
  c         Remove orphan cover art
  q         Quit

Keys while playing:
  p         Pause / resume
  h / l     Seek −10s / +10s
  L         Loop track
  q         Stop, back to the browser
EOF
}

main() {
    local music_dir="$HOME/Downloads/Telegram Desktop"

    while [[ $# -gt 0 ]]; do
        case $1 in
        -h | --help)
            help_text
            return 0
            ;;
        -d | --dir)
            shift
            [[ -n $1 ]] || {
                printf '%s\n' "${ERR}--dir requires a path${RESET}"
                exit 1
            }
            music_dir=$1
            ;;
        *)
            printf '%s\n' "${ERR}unknown option: $1${RESET}" "try $0 --help"
            exit 1
            ;;
        esac
        shift
    done

    init_style

    local -a required=(mpv jq socat)
    local -a missing=()
    local dep
    for dep in "${required[@]}"; do
        command -v "$dep" &>/dev/null || missing+=("$dep")
    done
    if ((${#missing[@]} > 0)); then
        printf '%s\n' "${ERR}missing dependencies: ${missing[*]}${RESET}"
        exit 1
    fi

    detect_viewer

    # Optional, keyless metadata tools: they let the app lift the real
    # embedded cover and read artist/album tags out of each file.
    FFMPEG_BIN=$(command -v ffmpeg 2>/dev/null)
    FFPROBE_BIN=$(command -v ffprobe 2>/dev/null)

    collect_media_files "$music_dir"
    browse_files
}

cleanup() {
    tput cnorm 2>/dev/null
    [[ -n $MPV_PID ]] && kill "$MPV_PID" 2>/dev/null
    rm -f -- /tmp/mpv-socket
    clear
    printf '%s\n' "${DIM}bye${RESET}"
    exit 0
}
trap cleanup INT TERM

# Run only when executed directly — sourcing lets tests drive the pieces.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
