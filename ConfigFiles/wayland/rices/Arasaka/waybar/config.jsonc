{
    "include": "~/.config/wayland/scripts/configs/waybar-modules.jsonc",

    "layer": "top",
    "position": "top",
    "exclusive": true,

    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "height": 48,
    "spacing": 8,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "tray"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "wireplumber",
        "cpu",
        "memory",
        "disk",
        "battery",
        "custom/logout"
    ]
}
